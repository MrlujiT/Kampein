{
  // Cloudflare Workers: the Kampein website (landing page, sign-ups, partner QR links,
  // admin and partner dashboards) plus the browser demo at /demo/.
  // The D1 database "kampein" is created automatically on the first deploy.
  // Admin access needs one secret, set in the Cloudflare dashboard: ADMIN_KEY.
  "name": "kampein",
  "main": "web/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./web/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/r/*", "/p/*", "/i/*"]
  },
  // web/investor.html is bundled into the worker as text, so it is never a public file
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "kampein" }
  ],
  "observability": { "enabled": true }
}
